<?xml version="1.0" encoding="utf-8"?>
<Script>
  <Setup name="View1_Back"/>
  <Navigator down="true" right="true"/>
  
  <!--Load content-->
  <AddImage path="World/DreamRoom7/back" name="front" show="true"/>
  
  <!--Turn triggers-->
  <ViewTrigger name="Down" next_view="View1_Front" type="fade_out"/>
  <ViewTrigger name="Right" next_view="Left_Zoom" type="fade_out"/>
  
  <!--Cursor triggers-->
  <CursorTrigger
    name="Trigger01"
    collision="rect"
    rect="515,110,740,660"
    cursor_style="use"
    trigger_type="event"
    trigger_event="View1_Back.onDoor"
    activate_own="true"/>
    
  <CursorTrigger
    name="Trigger02"
    collision="rect"
    rect="815,430,945,490"
    cursor_style="zoom_small"
    trigger_type="view"
    trigger_view="Teddy_Zoom"
    viewtrigger_type="fade_out"/>
    
  <!--Events-->
  <Event name="View1_Back.onDown">
    <Action type="ActivateTrigger" name="Down"/>
  </Event>
  
  <Event name="View1_Back.onRight">
    <Action type="ActivateTrigger" name="Right"/>
  </Event>
  
  <Event name="View1_Back.onDoor">
    <Case>
      <Check type1="GlobalState" value1="DreamRoom5.ShowMare2" rule="==" type2="String" value2="1"/>
      <True>
        <SetGlobalState state="DreamRoom5.ShowMare2" value="2"/>
      </True>
      <False/>
    </Case>
    
    <Action type="ChangeArea" area="DreamRoom5" view="Zoom_Stairs" door_sound="true"/>
  </Event>
  
</Script>