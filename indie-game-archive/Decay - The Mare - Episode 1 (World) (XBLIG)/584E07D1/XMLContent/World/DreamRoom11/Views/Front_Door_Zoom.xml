<?xml version="1.0" encoding="utf-8"?>
<Script>
  <Setup name="Front_Door_Zoom" navigator="false" hud_state="back" text_fade="true"/>
  
  <!--Load content-->
  <AddImage path="World/DreamRoom11/door_zoom" name="door" show="true"/>
  
  <!--Turn triggers-->
  <ViewTrigger name="Back" next_view="View1_Front" type="fade_out"/>
  
  <!--Cursor triggers-->
  <CursorTrigger
    name="Trigger01"
    collision="rect"
    rect="480,0,890,720"
    cursor_style="use"
    trigger_type="event"
    trigger_event="Front_Door_Zoom.onDoor"
    activate_own="true"/>
    
  <!--Events-->
  <Event name="Front_Door_Zoom.onBack">
    <Action type="ActivateTrigger" name="Back"/>
  </Event>
  
  <Event name="Front_Door_Zoom.onDoor">
    <Case>
      <Check type1="GlobalState" value1="DreamRoom13.Unlocked" rule="!=" type2="String" value2="1"/>
      <True>
        <Action type="ChangeArea" area="DreamRoom12" view="View1_Front" door_sound="true"/>
      </True>
      <False>
        <Action type="ChangeArea" area="DreamRoom13" view="View1_Front" door_sound="true"/>
      </False>
    </Case>
  </Event>
  
</Script>