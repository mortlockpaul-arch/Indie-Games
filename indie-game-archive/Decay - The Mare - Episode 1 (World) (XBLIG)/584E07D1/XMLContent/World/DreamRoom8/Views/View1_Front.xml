<?xml version="1.0" encoding="utf-8"?>
<Script>
  <Setup name="View1_Front"/>
  <Navigator down="true"/>
  
  <!--Load content-->
  <AddImage path="World/DreamRoom8/front" name="front" show="true"/>
  <AddImage path="World/DreamRoom8/front_paper_684x421" name="paper" show="false" dest_rect="684,421,132,45"/>
  
  <!--Turn triggers-->
  <ViewTrigger name="Down" next_view="View1_Back" type="fade_out"/>
  
  <!--Cursor triggers-->
  <CursorTrigger
    name="Trigger01"
    collision="rect"
    rect="684,421,816,466"
    cursor_style="zoom_small"
    trigger_type="view"
    trigger_view="Table_Zoom"
    viewtrigger_type="fade_out"/>
    
  <!--Events-->
  <Event name="View1_Front.onDown">
    <Action type="ActivateTrigger" name="Down"/>
  </Event>
  
  <Event name="View1_Front.onPaperAdded">
    <ShowImage name="paper"/>
  </Event>
  
  <Event name="View1_Front.onPaperRemoved">
    <HideImage name="paper"/>
  </Event>
  
  <!--Handle states-->
  <Case>
    <Check type1="GetState" value1="DreamRoom8.PoetryPuzzle" rule="!=" type2="String" value2=""/>
    <True>
      <HandleEvent event="View1_Front.onPaperAdded"/>
    </True>
    <False>
      <HandleEvent event="View1_Front.onPaperRemoved"/>
    </False>
  </Case>
  
</Script>