<?xml version="1.0" encoding="utf-8"?>
<Script>
  <Setup name="Table_Zoom" navigator="false" hud_state="back" text_fade="true"/>
  
  <!--Load content-->
  <AddImage path="World/DreamRoom8/table_zoom1" name="table_zoom1" show="true"/>
  <AddImage path="World/DreamRoom8/table_zoom_arrow_x184y133" name="paper_arrow" show="false" dest_rect="423,162,629,416"/>
  <AddImage path="World/DreamRoom8/table_zoom_eye_x184y133" name="paper_eye" show="false" dest_rect="423,162,629,416"/>
  <AddImage path="World/DreamRoom8/table_zoom_flame_x184y133" name="paper_flame" show="false" dest_rect="423,162,629,416"/>
  <AddImage path="World/DreamRoom8/table_zoom_tear_x184y133" name="paper_tear" show="false" dest_rect="423,162,629,416"/>
  
  <!--Turn triggers-->
  <ViewTrigger name="Back" next_view="View1_Front" type="fade_out"/>
  <ViewTrigger name="Light" next_view="Light_Sequence" type="fade_to_black"/>
  
  <!--Cursor triggers-->
    
  <!--Events-->
  <Event name="Table_Zoom.onBack">
    <Action type="ActivateTrigger" name="Back"/>
  </Event>
  
  <Event name="Table_Zoom.onReset">
    <UnblockInput/>
  </Event>
  
  <!--Poetry puzzle-->
  
  <!--Paper tear-->
  <Event name="Table_Zoom.Use.PaperTear">
    <Case>
      <Check type1="GetState" value1="DreamRoom8.PoetryPuzzle" rule="!=" type2="String" value2=""/>
      <True>
        <Action type="ShowText" text="I_NEED_TO_PICK_THAT_UP"/>
      </True>
      <False>
        <RemoveItem item_id="PaperTear"/>
        <HandleEvent event="View1_Front.onPaperAdded"/>
        <HandleEvent event="Table_Zoom.HandlePaper.PaperTear"/>
        <FadeInImage name="paper_tear"/>
        <SetGlobalState state="DreamRoom8.PoetryPuzzle" value="PaperTear"/>
      </False>
    </Case>
    
    <UseEventHandled/>
  </Event>
  
  <Event name="Table_Zoom.PaperTear">
    <Action type="AskPickup" item_id="PaperTear"/>
  </Event>
  
  <Event name="Pickup.PaperTear">
    <HandleEvent event="View1_Front.onPaperRemoved"/>
    <FadeOutImage name="paper_tear"/>
    <RemoveTrigger name="Trigger01"/>
    <SetGlobalState state="DreamRoom8.PoetryPuzzle" value=""/>
  </Event>
  
  <Event name="Table_Zoom.HandlePaper.PaperTear">
    <ShowImage name="paper_tear"/>
    <CursorTrigger
      name="Trigger01"
      collision="rect"
      rect="423,162,850,460"
      cursor_style="use"
      trigger_type="event"
      trigger_event="Table_Zoom.PaperTear"
      activate_own ="true"/>
  </Event>

  <!--Paper arrow-->
  <Event name="Table_Zoom.Use.PaperArrow">
    <Case>
      <Check type1="GetState" value1="DreamRoom8.PoetryPuzzle" rule="!=" type2="String" value2=""/>
      <True>
        <Action type="ShowText" text="I_NEED_TO_PICK_THAT_UP"/>
      </True>
      <False>
        <RemoveItem item_id="PaperArrow"/>
        <HandleEvent event="View1_Front.onPaperAdded"/>
        <HandleEvent event="Table_Zoom.HandlePaper.PaperArrow"/>
        <FadeInImage name="paper_arrow"/>
        <SetGlobalState state="DreamRoom8.PoetryPuzzle" value="PaperArrow"/>
      </False>
    </Case>
    
    <UseEventHandled/>
  </Event>
    
  <Event name="Table_Zoom.PaperArrow">
    <Action type="AskPickup" item_id="PaperArrow"/>
  </Event>
  
  <Event name="Pickup.PaperArrow">
    <HandleEvent event="View1_Front.onPaperRemoved"/>
    <FadeOutImage name="paper_arrow"/>
    <RemoveTrigger name="Trigger01"/>
    <SetGlobalState state="DreamRoom8.PoetryPuzzle" value=""/>
  </Event>
    
  <Event name="Table_Zoom.HandlePaper.PaperArrow">
    <ShowImage name="paper_arrow"/>
    <CursorTrigger
      name="Trigger01"
      collision="rect"
      rect="423,162,850,460"
      cursor_style="use"
      trigger_type="event"
      trigger_event="Table_Zoom.PaperArrow"
      activate_own ="true"/>
  </Event>
  
  <!--Paper eye-->
  <Event name="Table_Zoom.Use.PaperEye">
    <Case>
      <Check type1="GetState" value1="DreamRoom8.PoetryPuzzle" rule="!=" type2="String" value2=""/>
      <True>
        <Action type="ShowText" text="I_NEED_TO_PICK_THAT_UP"/>
      </True>
      <False>
        <RemoveItem item_id="PaperEye"/>
        <HandleEvent event="View1_Front.onPaperAdded"/>
        <HandleEvent event="Table_Zoom.HandlePaper.PaperEye"/>
        <FadeInImage name="paper_eye"/>
        <SetGlobalState state="DreamRoom8.PoetryPuzzle" value="PaperEye"/>
      </False>
    </Case>
    
    <UseEventHandled/>
  </Event>
    
  <Event name="Table_Zoom.PaperEye">
    <Action type="AskPickup" item_id="PaperEye"/>
  </Event>
  
  <Event name="Pickup.PaperEye">
    <HandleEvent event="View1_Front.onPaperRemoved"/>
    <FadeOutImage name="paper_eye"/>
    <RemoveTrigger name="Trigger01"/>
    <SetGlobalState state="DreamRoom8.PoetryPuzzle" value=""/>
  </Event>
    
  <Event name="Table_Zoom.HandlePaper.PaperEye">
    <ShowImage name="paper_eye"/>
    <CursorTrigger
      name="Trigger01"
      collision="rect"
      rect="423,162,850,460"
      cursor_style="use"
      trigger_type="event"
      trigger_event="Table_Zoom.PaperEye"
      activate_own ="true"/>
  </Event>
  
  <!--Paper flame-->
  <Event name="Table_Zoom.Use.PaperFlame">
    <Case>
      <Check type1="GetState" value1="DreamRoom8.PoetryPuzzle" rule="!=" type2="String" value2=""/>
      <True>
        <Action type="ShowText" text="I_NEED_TO_PICK_THAT_UP"/>
      </True>
      <False>
        <RemoveItem item_id="PaperFlame"/>
        <HandleEvent event="View1_Front.onPaperAdded"/>
        <HandleEvent event="Table_Zoom.HandlePaper.PaperFlame"/>
        <FadeInImage name="paper_flame"/>
        <SetGlobalState state="DreamRoom8.PoetryPuzzle" value="PaperFlame"/>
        <HandleEvent event="Table_Zoom.onPaperFlameAdded"/>
      </False>
    </Case>
    
    <UseEventHandled/>
  </Event>
    
  <Event name="Table_Zoom.PaperFlame">
    <Action type="AskPickup" item_id="PaperFlame"/>
  </Event>
  
  <Event name="Pickup.PaperFlame">
    <HandleEvent event="View1_Front.onPaperRemoved"/>
    <FadeOutImage name="paper_flame"/>
    <RemoveTrigger name="Trigger01"/>
    <SetGlobalState state="DreamRoom8.PoetryPuzzle" value=""/>
    <HandleEvent event="Table_Zoom.onPaperFlameRemoved"/>
  </Event>
    
  <Event name="Table_Zoom.HandlePaper.PaperFlame">
    <ShowImage name="paper_flame"/>
    <CursorTrigger
      name="Trigger01"
      collision="rect"
      rect="423,162,850,460"
      cursor_style="use"
      trigger_type="event"
      trigger_event="Table_Zoom.PaperFlame"
      activate_own ="true"/>
  </Event>
  
  <Event name="Table_Zoom.onPaperFlameAdded">
    <Case>
      <Check type1="GetState" value1="DreamRoom1.PoetryPuzzle" rule="==" type2="String" value2="PaperTear" nextCheck="AND"/>
      <Check type1="GetState" value1="DreamRoom8.PoetryPuzzle" rule="==" type2="String" value2="PaperFlame" nextCheck="AND"/>
      <Check type1="GetState" value1="DreamRoom11.PoetryPuzzle" rule="==" type2="String" value2="PaperEye" nextCheck="AND"/>
      <Check type1="GetState" value1="DreamRoom13.PoetryPuzzle" rule="==" type2="String" value2="PaperArrow"/>
      <True>
        <!--Show light (on) sequence in DreamRoom4-->
        <BlockInput/>
        <HandleEvent event="Light_Sequence.Setup.LightOn"/>
        <DelayedEvent event="Table_Zoom.ShowLightSequence" delay="1000"/>
      </True>
      <False>
      </False>
    </Case>
  </Event>
  
  <Event name="Table_Zoom.onPaperFlameRemoved">
    <Case>
      <Check type1="GetState" value1="DreamRoom1.PoetryPuzzle" rule="==" type2="String" value2="PaperTear" nextCheck="AND"/>
      <Check type1="GetState" value1="DreamRoom11.PoetryPuzzle" rule="==" type2="String" value2="PaperEye" nextCheck="AND"/>
      <Check type1="GetState" value1="DreamRoom13.PoetryPuzzle" rule="==" type2="String" value2="PaperArrow"/>
      <True>
        <!--Show light (off) sequence in DreamRoom4-->
        <BlockInput/>
        <HandleEvent event="Light_Sequence.Setup.LightOff"/>
        <DelayedEvent event="Table_Zoom.ShowLightSequence" delay="1000"/>
      </True>
      <False>
      </False>
    </Case>
  </Event>
  
  <Event name="Table_Zoom.ShowLightSequence">
    <Action type="FadeOutHUD"/>
    <Action type="ActivateTrigger" name="Light"/>
  </Event>
  
  <!--Handle states-->
  <HandleState state="DreamRoom8.PoetryPuzzle" event="Table_Zoom.HandlePaper"/>
  
</Script>