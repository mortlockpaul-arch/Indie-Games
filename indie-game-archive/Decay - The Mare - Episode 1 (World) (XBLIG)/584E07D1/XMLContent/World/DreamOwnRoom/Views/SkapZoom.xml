<?xml version="1.0" encoding="utf-8"?>
<Script>
  <Setup name="SkapZoom" navigator="false" hud_state="back" text_fade="true"/>

  <!--Load content-->
  <AddImage path="World/DreamOwnRoom/skap_zoom_pa_glant" name="skap_zoom_pa_glant" show="true"/>
  <AddImage path="World/DreamOwnRoom/skap_zoom_dream" name="skap_zoom_dream" show="false"/>
  
  <!--View triggers-->
  <ViewTrigger name="Back" next_view="View2" type="fade_out"/>
  <ViewTrigger name="OpenCloset" next_view="SkapZoomOpen" type="fade_to_black"/>

  <!--Cursor triggers-->
  <CursorTrigger
    name="Trigger01"
    collision="rect"
    rect="360,0,840,720"
    cursor_style="use"
    trigger_type="event"
    trigger_event="SkapZoom.OpenCloset"
    activate_own ="true"/>
  
  <!--Events-->
  <Event name="SkapZoom.onBack">
    <Action type="ActivateTrigger" name="Back"/>
  </Event>
  
  <Event name="SkapZoom.onReset">
    <Case>
      <Check type1="GlobalState" value1="DreamRoom4.PuzzleCompleted" rule="==" type2="String" value2="1"/>
      <True>
        <Action type="GameDataArea" value="DreamECT"/>
        <Action type="GameDataView" value="View1_Back"/>
      </True>
      <False/>
    </Case>
  </Event>
  
  <Event name="SkapZoom.OpenCloset">
    <Action type="ActivateTrigger" name="OpenCloset"/>
    <PlayDoorSound/>
  </Event>
  
  <Event name="SkapZoom.ClosetState.1">
    <HideImage name="skap_zoom_pa_glant"/>
    <ShowImage name="skap_zoom_dream"/>
  </Event>
  
  <HandleState state="DreamOwnRoom.ClosetState" event="SkapZoom.ClosetState"/>
  
</Script>