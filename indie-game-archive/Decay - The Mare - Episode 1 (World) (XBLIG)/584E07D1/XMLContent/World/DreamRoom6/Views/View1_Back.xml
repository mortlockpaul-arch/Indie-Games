<?xml version="1.0" encoding="utf-8"?>
<Script>
  <Setup name="View1_Back"/>
  <Navigator down="true" left="true" right="true"/>
  
  <!--Load content-->
  <AddImage path="World/DreamRoom6/back" name="front" show="true"/>
  <AddImage path="World/DreamRoom6/back2" name="light" show="false"/>
  
  <!--View triggers-->
  <ViewTrigger name="Down" next_view="View1_Front" type="fade_out"/>
  <ViewTrigger name="Left" next_view="View1_Right" type="fade_out"/>
  <ViewTrigger name="Right" next_view="View1_Left" type="fade_out"/>
  
  <!--Cursor triggers-->
  <CursorTrigger
    name="Trigger01"
    collision="rect"
    rect="320,0,810,720"
    cursor_style="use"
    trigger_type="event"
    trigger_event="View1_Back.onDoor"
    activate_own="true"/>
    
  <!--Events-->
  <Event name="View1_Back.onDown">
    <Action type="ActivateTrigger" name="Down"/>
  </Event>
  
  <Event name="View1_Back.onLeft">
    <Action type="ActivateTrigger" name="Left"/>
  </Event>
  
  <Event name="View1_Back.onRight">
    <Action type="ActivateTrigger" name="Right"/>
  </Event>
  
  <Event name="DreamRoom6.Flicker1">
    <ShowImage name="light"/>
  </Event>
  
  <Event name="DreamRoom6.Flicker2">
    <HideImage name="light"/>
  </Event>
  
  <Event name="View1_Back.onDoor">
    <Action type="ChangeArea" area="DreamRoom5" view="View2_Front" door_sound="true"/>
  </Event>
  
</Script>