<?xml version="1.0" encoding="utf-8"?>
<Script>

  <!--Handle number of visits for this room-->
  <Case>
    <Check type1="GlobalState" value1="DreamRoom6.Visits" rule="==" type2="String" value2=""/>
    <True>
      <SetGlobalState state="DreamRoom6.Visits" value="0"/>
    </True>
    <False/>
  </Case>
  
  <SetLocalState state="Visits" global_state="DreamRoom6.Visits"/>
  <SetLocalState state="Visits" add="1"/>
  
  <Case>
    <Check type1="LocalState" value1="Visits" rule="==" type2="String" value2="5"/>
    <True>
      <SetLocalState state="Visits" value="4"/>
    </True>
    <False/>
  </Case>
  
  <SetGlobalState state="DreamRoom6.Visits" local_state="Visits"/>
  
  <!--Load content-->
  <LoadContent type="Sound" path="World/DreamRoom6/Sound/drawer"/>
  <Action type="CreateSoundInstance" path="World/DreamRoom6/Sound/drawer" name="drawer_sound"/>
  
  <!--Create views-->
  <ViewPath>XMLContent/World/DreamRoom6/Views/</ViewPath>
  <View>View1_Front</View>
  <View>View1_Back</View>
  <View>View1_Left</View>
  <View>View1_Right</View>
  <View>Front_Zoom</View>
  <View>Drawer_Zoom</View>
  <View>Drawer_Open</View>
  
  <!--Events-->
  <DelayedEvent event="DreamRoom6.Flicker1" min_delay="10" max_delay="2000"/>
  
  <Event name="DreamRoom6.Flicker1">
    <DelayedEvent event="DreamRoom6.Flicker2" min_delay="10" max_delay="2000"/>
  </Event>
  
  <Event name="DreamRoom6.Flicker2">
    <DelayedEvent event="DreamRoom6.Flicker1" min_delay="10" max_delay="2000"/>
  </Event>
  
  <Event name="DreamRoom6.PlayDrawerSound">
    <Action type="SoundInstance" name="drawer_sound" volume="0,1" action="Play"/>
  </Event>
  
  <PlayMusic value="1"/>
  
</Script>