<?xml version="1.0" encoding="utf-8"?>
<Script>
  <Setup name="View1_Front"/>
  <Navigator down="true"/>
  
  <!--Load content-->
  <AddImage path="World/DreamRoom13/view1" name="view1" show="true"/>
  
  <LoadContent type="TextureAnimation"
               path="World/DreamRoom13/Animations/Curtain/" images="2"
               combinedFrames="true" width="167" height="289" frames="151"
               frameSmoothing="false" size="2048" fps="25"
               />
               
  <Action type="CreateAnimationInstance" path="World/DreamRoom13/Animations/Curtain/" name="curtain_anim" dest_rect="219,102,167,289"/>
  <Action type="AnimationInstance" name="curtain_anim" action="Play" loop="ping_pong"/>
  <Action type="AnimationInstance" name="curtain_anim" action="show"/>
  
  <!--Turn triggers-->
  <ViewTrigger name="Down" next_view="View1_Back" type="fade_out"/>
  
  <!--Cursor triggers-->
  <CursorTrigger
    name="Trigger01"
    collision="rect"
    rect="430,280,550,320"
    cursor_style="zoom_small"
    trigger_type="view"
    trigger_view="Table_Zoom"
    viewtrigger_type="fade_out"/>
    
  <CursorTrigger
    name="Trigger02"
    collision="rect"
    rect="860,140,995,445"
    cursor_style="zoom"
    trigger_type="view"
    trigger_view="Right_Zoom"
    viewtrigger_type="fade_out"/>
    
  <!--Events-->
  <Event name="View1_Front.onDown">
    <Action type="ActivateTrigger" name="Down"/>
  </Event>
  
  <Event name="View1_Front.onReset">
    <SetGlobalState state="DreamRoom13.Unlocked" value="1"/>
  </Event>
  
</Script>