<?xml version="1.0" encoding="utf-8"?>
<Script>
  <Setup name="View1_Back"/>
  <Navigator down="true"/>
  
  <!--Load content-->
  <AddImage path="World/DreamRoom13/back" name="back" show="true"/>
  <AddImage path="World/DreamRoom13/back_drawings_x59y385" name="drawings" show="true" dest_rect="59,385,310,88"/>
  
  <!--Turn triggers-->
  <ViewTrigger name="Down" next_view="View1_Front" type="fade_out"/>
  
  <!--Cursor triggers-->
  <CursorTrigger
    name="Trigger01"
    collision="rect"
    rect="600,155,800,595"
    cursor_style="use"
    trigger_type="event"
    trigger_event="View1_Back.onDoor"
    activate_own="true"/>
    
  <CursorTrigger
    name="Trigger02"
    collision="rect"
    rect="59,385,369,473"
    cursor_style="zoom"
    trigger_type="view"
    trigger_view="Table2_Zoom"
    viewtrigger_type="fade_out"/>
    
  <!--Events-->
  <Event name="View1_Back.onDown">
    <Action type="ActivateTrigger" name="Down"/>
  </Event>
  
  <Event name="View1_Back.onDoor">
    <Action type="ChangeArea" area="DreamRoom11" view="View1_Front" door_sound="true"/>
  </Event>
  
  <Event name="View1_Back.HandleDrawings.1">
    <HideImage name="drawings"/>
    <RemoveTrigger name="Trigger02"/>
  </Event>
  
  <!--Handle states-->
  <HandleState state="DreamRoom13.Drawings" event="View1_Back.HandleDrawings"/>
  
</Script>