<?xml version="1.0" encoding="utf-8"?>
<Script>
  <Setup name="Table_Zoom" navigator="false" hud_state="back" text_fade="true"/>
  
  <!--Load content-->
  <AddImage path="World/DreamRoom13/tablezoom" name="tablezoom" show="true"/>
  <AddImage path="World/DreamRoom13/tablezoom_arrow_x193y353" name="paper_arrow" show="false" dest_rect="193,353,425,323"/>
  <AddImage path="World/DreamRoom13/tablezoom_eye_x193y353" name="paper_eye" show="false" dest_rect="193,353,425,323"/>
  <AddImage path="World/DreamRoom13/tablezoom_flame_x193y353" name="paper_flame" show="false" dest_rect="193,353,425,323"/>
  <AddImage path="World/DreamRoom13/tablezoom_tear_x193y353" name="paper_tear" show="false" dest_rect="193,353,425,323"/>
  <AddImage path="World/DreamRoom13/tablezoom_coin_x187y111" name="coin" show="true" dest_rect="187,111,44,21"/>
  
  <!--Turn triggers-->
  <ViewTrigger name="Back" next_view="View1_Front" type="fade_out"/>
  <ViewTrigger name="Light" next_view="Light_Sequence" type="fade_to_black"/>
  
  <!--Cursor triggers-->
  <CursorTrigger
    name="Trigger02"
    collision="rect"
    rect="187,111,231,132"
    cursor_style="use_small"
    trigger_type="event"
    trigger_event="Table_Zoom.Coin"
    activate_own ="true"/>
    
  <CursorTrigger
    name="Trigger03"
    collision="rect"
    rect="385,470,515,550"
    cursor_style="zoom"
    trigger_type="event"
    trigger_event="Table_Zoom.onFlower"
    activate_own ="true"/>
    
  <!--Events-->
  <Event name="Table_Zoom.onBack">
    <Action type="ActivateTrigger" name="Back"/>
  </Event>
  
  <Event name="Table_Zoom.onReset">
    <UnblockInput/>
  </Event>
  
  <!--Poetry puzzle-->
  
  <!--Paper tear-->
  <Event name="Table_Zoom.Use.PaperTear">
    <Case>
      <Check type1="GetState" value1="DreamRoom13.PoetryPuzzle" rule="!=" type2="String" value2=""/>
      <True>
        <Action type="ShowText" text="I_NEED_TO_PICK_THAT_UP"/>
      </True>
      <False>
        <RemoveItem item_id="PaperTear"/>
        <HandleEvent event="Table_Zoom.HandlePaper.PaperTear"/>
        <FadeInImage name="paper_tear"/>
        <SetGlobalState state="DreamRoom13.PoetryPuzzle" value="PaperTear"/>
      </False>
    </Case>
    
    <UseEventHandled/>
  </Event>
  
  <Event name="Table_Zoom.PaperTear">
    <Action type="AskPickup" item_id="PaperTear"/>
  </Event>
  
  <Event name="Pickup.PaperTear">
    <FadeOutImage name="paper_tear"/>
    <RemoveTrigger name="Trigger01"/>
    <SetGlobalState state="DreamRoom13.PoetryPuzzle" value=""/>
    <EnableTrigger name="Trigger03"/>
  </Event>
  
  <Event name="Table_Zoom.HandlePaper.PaperTear">
    <DisableTrigger name="Trigger03"/>
    <ShowImage name="paper_tear"/>
    <CursorTrigger
      name="Trigger01"
      collision="rect"
      rect="265,348,626,643"
      cursor_style="use"
      trigger_type="event"
      trigger_event="Table_Zoom.PaperTear"
      activate_own ="true"/>
  </Event>

  <!--Paper arrow-->
  <Event name="Table_Zoom.Use.PaperArrow">
    <Case>
      <Check type1="GetState" value1="DreamRoom13.PoetryPuzzle" rule="!=" type2="String" value2=""/>
      <True>
        <Action type="ShowText" text="I_NEED_TO_PICK_THAT_UP"/>
      </True>
      <False>
        <RemoveItem item_id="PaperArrow"/>
        <HandleEvent event="Table_Zoom.HandlePaper.PaperArrow"/>
        <FadeInImage name="paper_arrow"/>
        <SetGlobalState state="DreamRoom13.PoetryPuzzle" value="PaperArrow"/>
        <HandleEvent event="Table_Zoom.onPaperArrowAdded"/>
      </False>
    </Case>
    
    <UseEventHandled/>
  </Event>
    
  <Event name="Table_Zoom.PaperArrow">
    <Action type="AskPickup" item_id="PaperArrow"/>
  </Event>
  
  <Event name="Pickup.PaperArrow">
    <FadeOutImage name="paper_arrow"/>
    <RemoveTrigger name="Trigger01"/>
    <SetGlobalState state="DreamRoom13.PoetryPuzzle" value=""/>
    <HandleEvent event="Table_Zoom.onPaperArrowRemoved"/>
    <EnableTrigger name="Trigger03"/>
  </Event>
    
  <Event name="Table_Zoom.HandlePaper.PaperArrow">
    <DisableTrigger name="Trigger03"/>
    <ShowImage name="paper_arrow"/>
    <CursorTrigger
      name="Trigger01"
      collision="rect"
      rect="265,348,626,643"
      cursor_style="use"
      trigger_type="event"
      trigger_event="Table_Zoom.PaperArrow"
      activate_own ="true"/>
  </Event>
  
  <!--Paper eye-->
  <Event name="Table_Zoom.Use.PaperEye">
    <Case>
      <Check type1="GetState" value1="DreamRoom13.PoetryPuzzle" rule="!=" type2="String" value2=""/>
      <True>
        <Action type="ShowText" text="I_NEED_TO_PICK_THAT_UP"/>
      </True>
      <False>
        <RemoveItem item_id="PaperEye"/>
        <HandleEvent event="Table_Zoom.HandlePaper.PaperEye"/>
        <FadeInImage name="paper_eye"/>
        <SetGlobalState state="DreamRoom13.PoetryPuzzle" value="PaperEye"/>
      </False>
    </Case>
    
    <UseEventHandled/>
  </Event>
    
  <Event name="Table_Zoom.PaperEye">
    <Action type="AskPickup" item_id="PaperEye"/>
  </Event>
  
  <Event name="Pickup.PaperEye">
    <FadeOutImage name="paper_eye"/>
    <RemoveTrigger name="Trigger01"/>
    <SetGlobalState state="DreamRoom13.PoetryPuzzle" value=""/>
    <EnableTrigger name="Trigger03"/>
  </Event>
    
  <Event name="Table_Zoom.HandlePaper.PaperEye">
    <DisableTrigger name="Trigger03"/>
    <ShowImage name="paper_eye"/>
    <CursorTrigger
      name="Trigger01"
      collision="rect"
      rect="265,348,626,643"
      cursor_style="use"
      trigger_type="event"
      trigger_event="Table_Zoom.PaperEye"
      activate_own ="true"/>
  </Event>
  
  <!--Paper flame-->
  <Event name="Table_Zoom.Use.PaperFlame">
    <Case>
      <Check type1="GetState" value1="DreamRoom13.PoetryPuzzle" rule="!=" type2="String" value2=""/>
      <True>
        <Action type="ShowText" text="I_NEED_TO_PICK_THAT_UP"/>
      </True>
      <False>
        <RemoveItem item_id="PaperFlame"/>
        <HandleEvent event="Table_Zoom.HandlePaper.PaperFlame"/>
        <FadeInImage name="paper_flame"/>
        <SetGlobalState state="DreamRoom13.PoetryPuzzle" value="PaperFlame"/>
      </False>
    </Case>
    
    <UseEventHandled/>
  </Event>
    
  <Event name="Table_Zoom.PaperFlame">
    <Action type="AskPickup" item_id="PaperFlame"/>
  </Event>
  
  <Event name="Pickup.PaperFlame">
    <FadeOutImage name="paper_flame"/>
    <RemoveTrigger name="Trigger01"/>
    <SetGlobalState state="DreamRoom13.PoetryPuzzle" value=""/>
    <EnableTrigger name="Trigger03"/>
  </Event>
    
  <Event name="Table_Zoom.HandlePaper.PaperFlame">
    <DisableTrigger name="Trigger03"/>
    <ShowImage name="paper_flame"/>
    <CursorTrigger
      name="Trigger01"
      collision="rect"
      rect="265,348,626,643"
      cursor_style="use"
      trigger_type="event"
      trigger_event="Table_Zoom.PaperFlame"
      activate_own ="true"/>
  </Event>
  
  <Event name="Table_Zoom.onPaperArrowAdded">
    <Case>
      <Check type1="GetState" value1="DreamRoom1.PoetryPuzzle" rule="==" type2="String" value2="PaperTear" nextCheck="AND"/>
      <Check type1="GetState" value1="DreamRoom8.PoetryPuzzle" rule="==" type2="String" value2="PaperFlame" nextCheck="AND"/>
      <Check type1="GetState" value1="DreamRoom11.PoetryPuzzle" rule="==" type2="String" value2="PaperEye" nextCheck="AND"/>
      <Check type1="GetState" value1="DreamRoom13.PoetryPuzzle" rule="==" type2="String" value2="PaperArrow"/>
      <True>
        <!--Show light (on) sequence in DreamRoom4-->
        <BlockInput/>
        <HandleEvent event="Light_Sequence.Setup.LightOn"/>
        <DelayedEvent event="Table_Zoom.ShowLightSequence" delay="1000"/>
      </True>
      <False>
      </False>
    </Case>
  </Event>
  
  <Event name="Table_Zoom.onPaperArrowRemoved">
    <Case>
      <Check type1="GetState" value1="DreamRoom1.PoetryPuzzle" rule="==" type2="String" value2="PaperTear" nextCheck="AND"/>
      <Check type1="GetState" value1="DreamRoom8.PoetryPuzzle" rule="==" type2="String" value2="PaperFlame" nextCheck="AND"/>
      <Check type1="GetState" value1="DreamRoom11.PoetryPuzzle" rule="==" type2="String" value2="PaperEye"/>
      <True>
        <!--Show light (off) sequence in DreamRoom4-->
        <BlockInput/>
        <HandleEvent event="Light_Sequence.Setup.LightOff"/>
        <DelayedEvent event="Table_Zoom.ShowLightSequence" delay="1000"/>
      </True>
      <False>
      </False>
    </Case>
  </Event>
  
  <Event name="Table_Zoom.ShowLightSequence">
    <Action type="FadeOutHUD"/>
    <Action type="ActivateTrigger" name="Light"/>
  </Event>
  
  <Event name="Table_Zoom.Coin">
    <Action type="AskPickup" item_id="Coin"/>
  </Event>

  <Event name="Pickup.Coin">
    <FadeOutImage name="coin"/>
    <RemoveTrigger name="Trigger02"/>
    <SetGlobalState state="DreamRoom13.Coin" value="1"/>
  </Event>
  
  <Event name="Table_Zoom.HandleCoin.1">
    <HideImage name="coin"/>
    <RemoveTrigger name="Trigger02"/>
  </Event>
  
  <Event name="Table_Zoom.onFlower">
    <Action type="ShowText" text="A flower ..."/>
  </Event>
  
  <!--Handle states-->
  <HandleState state="DreamRoom13.PoetryPuzzle" event="Table_Zoom.HandlePaper"/>
  <HandleState state="DreamRoom13.Coin" event="Table_Zoom.HandleCoin"/>
  
</Script>