<?xml version="1.0" encoding="utf-8"?>
<Script>
  <Setup name="Ring_Zoom" navigator="false" hud_state="back" text_fade="true"/>
  
  <!--Load content-->
  <AddImage path="World/DreamRoom1/ring_zoom" name="zoom_door_room3" show="true"/>
  <AddImage path="World/DreamRoom1/ring_zoom_arrow_x507y509" name="paper_arrow" show="false" dest_rect="507,504,158,117"/>
  <AddImage path="World/DreamRoom1/ring_zoom_eye_x507y509" name="paper_eye" show="false" dest_rect="507,504,158,117"/>
  <AddImage path="World/DreamRoom1/ring_zoom_flame_x507y509" name="paper_flame" show="false" dest_rect="507,504,158,117"/>
  <AddImage path="World/DreamRoom1/ring_zoom_tear_x507y509" name="paper_tear" show="false" dest_rect="507,504,158,117"/>
  
  <!--Turn triggers-->
  <ViewTrigger name="Back" next_view="View3_Front" type="fade_out"/>
  <ViewTrigger name="Light" next_view="Light_Sequence" type="fade_to_black"/>
  
  <!--Cursor triggers-->
    
  <!--Events-->
  <Event name="Ring_Zoom.onBack">
    <Action type="ActivateTrigger" name="Back"/>
  </Event>
  
  <Event name="Ring_Zoom.onReset">
    <UnblockInput/>
  </Event>
  
  <!--Poetry puzzle-->
  
  <!--Paper tear-->
  <Event name="Ring_Zoom.Use.PaperTear">
    <Case>
      <Check type1="GetState" value1="DreamRoom1.PoetryPuzzle" rule="!=" type2="String" value2=""/>
      <True>
        <Action type="ShowText" text="I_NEED_TO_PICK_THAT_UP"/>
      </True>
      <False>
        <RemoveItem item_id="PaperTear"/>
        <HandleEvent event="View2_Front.onPaperAdded"/>
        <HandleEvent event="View3_Front.onPaperAdded"/>
        <HandleEvent event="Ring_Zoom.HandlePaper.PaperTear"/>
        <FadeInImage name="paper_tear"/>
        <Action type="SetState" id="DreamRoom1.PoetryPuzzle" state="PaperTear"/>
        <HandleEvent event="Ring_Zoom.onPaperTearAdded"/>
      </False>
    </Case>
    
    <UseEventHandled/>
  </Event>
  
  <Event name="Ring_Zoom.onPaperTearAdded">
    <Case>
      <Check type1="GetState" value1="DreamRoom1.PoetryPuzzle" rule="==" type2="String" value2="PaperTear" nextCheck="AND"/>
      <Check type1="GetState" value1="DreamRoom8.PoetryPuzzle" rule="==" type2="String" value2="PaperFlame" nextCheck="AND"/>
      <Check type1="GetState" value1="DreamRoom11.PoetryPuzzle" rule="==" type2="String" value2="PaperEye" nextCheck="AND"/>
      <Check type1="GetState" value1="DreamRoom13.PoetryPuzzle" rule="==" type2="String" value2="PaperArrow"/>
      <True>
        <!--Show light (on) sequence in DreamRoom4-->
        <BlockInput/>
        <HandleEvent event="Light_Sequence.Setup.LightOn"/>
        <DelayedEvent event="Ring_Zoom.ShowLightSequence" delay="1000"/>
      </True>
      <False>
      </False>
    </Case>
  </Event>
  
  <Event name="Ring_Zoom.PaperTear">
    <Action type="AskPickup" item_id="PaperTear"/>
  </Event>
  
  <Event name="Pickup.PaperTear">
    <HandleEvent event="View2_Front.onPaperRemoved"/>
    <HandleEvent event="View3_Front.onPaperRemoved"/>
    <FadeOutImage name="paper_tear"/>
    <RemoveTrigger name="Trigger01"/>
    <Action type="SetState" id="DreamRoom1.PoetryPuzzle" state=""/>
    <HandleEvent event="Ring_Zoom.onPaperTearRemoved"/>
  </Event>
  
  <Event name="Ring_Zoom.onPaperTearRemoved">
    <Case>
      <Check type1="GetState" value1="DreamRoom8.PoetryPuzzle" rule="==" type2="String" value2="PaperFlame" nextCheck="AND"/>
      <Check type1="GetState" value1="DreamRoom11.PoetryPuzzle" rule="==" type2="String" value2="PaperEye" nextCheck="AND"/>
      <Check type1="GetState" value1="DreamRoom13.PoetryPuzzle" rule="==" type2="String" value2="PaperArrow"/>
      <True>
        <!--Show light (off) sequence in DreamRoom4-->
        <BlockInput/>
        <HandleEvent event="Light_Sequence.Setup.LightOff"/>
        <DelayedEvent event="Ring_Zoom.ShowLightSequence" delay="1000"/>
      </True>
      <False>
      </False>
    </Case>
  </Event>
  
  <Event name="Ring_Zoom.HandlePaper.PaperTear">
    <ShowImage name="paper_tear"/>
    <CursorTrigger
      name="Trigger01"
      collision="rect"
      rect="507,504,665,621"
      cursor_style="use"
      trigger_type="event"
      trigger_event="Ring_Zoom.PaperTear"
      activate_own ="true"/>
  </Event>

  <!--Paper arrow-->
  <Event name="Ring_Zoom.Use.PaperArrow">
    <Case>
      <Check type1="GetState" value1="DreamRoom1.PoetryPuzzle" rule="!=" type2="String" value2=""/>
      <True>
        <Action type="ShowText" text="I_NEED_TO_PICK_THAT_UP"/>
      </True>
      <False>
        <RemoveItem item_id="PaperArrow"/>
        <HandleEvent event="View2_Front.onPaperAdded"/>
        <HandleEvent event="View3_Front.onPaperAdded"/>
        <HandleEvent event="Ring_Zoom.HandlePaper.PaperArrow"/>
        <FadeInImage name="paper_arrow"/>
        <Action type="SetState" id="DreamRoom1.PoetryPuzzle" state="PaperArrow"/>
      </False>
    </Case>
    
    <UseEventHandled/>
  </Event>
    
  <Event name="Ring_Zoom.PaperArrow">
    <Action type="AskPickup" item_id="PaperArrow"/>
  </Event>
  
  <Event name="Pickup.PaperArrow">
    <HandleEvent event="View2_Front.onPaperRemoved"/>
    <HandleEvent event="View3_Front.onPaperRemoved"/>
    <FadeOutImage name="paper_arrow"/>
    <RemoveTrigger name="Trigger01"/>
    <Action type="SetState" id="DreamRoom1.PoetryPuzzle" state=""/>
  </Event>
    
  <Event name="Ring_Zoom.HandlePaper.PaperArrow">
    <ShowImage name="paper_arrow"/>
    <CursorTrigger
      name="Trigger01"
      collision="rect"
      rect="507,504,665,621"
      cursor_style="use"
      trigger_type="event"
      trigger_event="Ring_Zoom.PaperArrow"
      activate_own ="true"/>
  </Event>
  
  <!--Paper eye-->
  <Event name="Ring_Zoom.Use.PaperEye">
    <Case>
      <Check type1="GetState" value1="DreamRoom1.PoetryPuzzle" rule="!=" type2="String" value2=""/>
      <True>
        <Action type="ShowText" text="I_NEED_TO_PICK_THAT_UP"/>
      </True>
      <False>
        <RemoveItem item_id="PaperEye"/>
        <HandleEvent event="View2_Front.onPaperAdded"/>
        <HandleEvent event="View3_Front.onPaperAdded"/>
        <HandleEvent event="Ring_Zoom.HandlePaper.PaperEye"/>
        <FadeInImage name="paper_eye"/>
        <Action type="SetState" id="DreamRoom1.PoetryPuzzle" state="PaperEye"/>
      </False>
    </Case>
    
    <UseEventHandled/>
  </Event>
    
  <Event name="Ring_Zoom.PaperEye">
    <Action type="AskPickup" item_id="PaperEye"/>
  </Event>
  
  <Event name="Pickup.PaperEye">
    <HandleEvent event="View2_Front.onPaperRemoved"/>
    <HandleEvent event="View3_Front.onPaperRemoved"/>
    <FadeOutImage name="paper_eye"/>
    <RemoveTrigger name="Trigger01"/>
    <Action type="SetState" id="DreamRoom1.PoetryPuzzle" state=""/>
  </Event>
    
  <Event name="Ring_Zoom.HandlePaper.PaperEye">
    <ShowImage name="paper_eye"/>
    <CursorTrigger
      name="Trigger01"
      collision="rect"
      rect="507,504,665,621"
      cursor_style="use"
      trigger_type="event"
      trigger_event="Ring_Zoom.PaperEye"
      activate_own ="true"/>
  </Event>
  
  <!--Paper flame-->
  <Event name="Ring_Zoom.Use.PaperFlame">
    <Case>
      <Check type1="GetState" value1="DreamRoom1.PoetryPuzzle" rule="!=" type2="String" value2=""/>
      <True>
        <Action type="ShowText" text="I_NEED_TO_PICK_THAT_UP"/>
      </True>
      <False>
        <RemoveItem item_id="PaperFlame"/>
        <HandleEvent event="View2_Front.onPaperAdded"/>
        <HandleEvent event="View3_Front.onPaperAdded"/>
        <HandleEvent event="Ring_Zoom.HandlePaper.PaperFlame"/>
        <FadeInImage name="paper_flame"/>
        <Action type="SetState" id="DreamRoom1.PoetryPuzzle" state="PaperFlame"/>
      </False>
    </Case>
    
    <UseEventHandled/>
  </Event>
    
  <Event name="Ring_Zoom.PaperFlame">
    <Action type="AskPickup" item_id="PaperFlame"/>
  </Event>
  
  <Event name="Pickup.PaperFlame">
    <HandleEvent event="View2_Front.onPaperRemoved"/>
    <HandleEvent event="View3_Front.onPaperRemoved"/>
    <FadeOutImage name="paper_flame"/>
    <RemoveTrigger name="Trigger01"/>
    <Action type="SetState" id="DreamRoom1.PoetryPuzzle" state=""/>
  </Event>
    
  <Event name="Ring_Zoom.HandlePaper.PaperFlame">
    <ShowImage name="paper_flame"/>
    <CursorTrigger
      name="Trigger01"
      collision="rect"
      rect="507,504,665,621"
      cursor_style="use"
      trigger_type="event"
      trigger_event="Ring_Zoom.PaperFlame"
      activate_own ="true"/>
  </Event>
  
  <Event name="Ring_Zoom.ShowLightSequence">
    <Action type="FadeOutHUD"/>
    <Action type="ActivateTrigger" name="Light"/>
  </Event>
  
  <!--Handle states-->
  <HandleState state="DreamRoom1.PoetryPuzzle" event="Ring_Zoom.HandlePaper"/>
  
</Script>