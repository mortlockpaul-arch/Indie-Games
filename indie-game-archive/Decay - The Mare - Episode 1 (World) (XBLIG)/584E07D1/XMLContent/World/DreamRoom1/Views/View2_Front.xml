<?xml version="1.0" encoding="utf-8"?>
<Script>
  <Setup name="View2_Front"/>
  <Navigator down="true"/>
  
  <!--Load content-->
  <AddImage path="World/DreamRoom1/view2_front" name="view2_front" show="true"/>
  <AddImage path="World/DreamRoom1/view2_front_document_x630y444" name="paper" show="false" dest_rect="630,444,60,26"/>
    
  <!--Turn triggers-->
  <ViewTrigger name="Down" next_view="View2_Back" type="fade_out"/>
  
  <!--Cursor triggers-->
  <CursorTrigger
    name="Trigger01"
    collision="rect"
    rect="330,220,710,550"
    cursor_style="zoom"
    trigger_type="view"
    trigger_view="View3_Front"
    viewtrigger_type="fade_out"/>
    
  <CursorTrigger
    name="Trigger02"
    collision="rect"
    rect="740,370,870,600"
    cursor_style="zoom"
    trigger_type="view"
    trigger_view="Stairs_Zoom"
    viewtrigger_type="fade_out"/>
    
  <!--Events-->
  <Event name="View2_Front.onDown">
    <Action type="ActivateTrigger" name="Down"/>
  </Event>
  
  <Event name="View2_Front.onPaperAdded">
    <ShowImage name="paper"/>
  </Event>
  
  <Event name="View2_Front.onPaperRemoved">
    <HideImage name="paper"/>
  </Event>
  
  <!--Handle states-->
  <Case>
    <Check type1="GetState" value1="DreamRoom1.PoetryPuzzle" rule="!=" type2="String" value2=""/>
    <True>
      <HandleEvent event="View2_Front.onPaperAdded"/>
    </True>
    <False>
      <HandleEvent event="View2_Front.onPaperRemoved"/>
    </False>
  </Case>
    
</Script>