<?xml version="1.0" encoding="utf-8"?>
<Script>
  <Setup name="Zoom_Door_Floor3" navigator="false" hud_state="back"/>
  <Navigator down="true"/>
  
  <!--Load content-->
  <AddImage path="World/DreamRoom5/zoom_door_floor3" name="zoom_door_floor3" show="true"/>
  
  <!--View triggers-->
  <ViewTrigger name="Back" next_view="Zoom_Stairs" type="fade_out"/>
  
  <!--Cursor triggers-->
  <CursorTrigger
    name="Trigger01"
    collision="rect"
    rect="470,150,730,690"
    cursor_style="use"
    trigger_type="event"
    trigger_event="Zoom_Door_Floor3.onDoor"
    activate_own="true"/>
    
  <!--Events-->
  <Event name="Zoom_Door_Floor3.onBack">
    <Action type="ActivateTrigger" name="Back"/>
  </Event>
  
  <Event name="Zoom_Door_Floor3.onDoor">
    <Action type="ChangeArea" area="DreamRoom9" view="View1_Back" door_sound="true"/>
  </Event>
  
</Script>