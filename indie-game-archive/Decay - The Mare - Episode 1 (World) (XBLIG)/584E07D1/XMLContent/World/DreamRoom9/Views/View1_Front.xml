<?xml version="1.0" encoding="utf-8"?>
<Script>
  <Setup name="View1_Front"/>
  <Navigator down="true"/>
  
  <!--Load content-->
  <AddImage path="World/DreamRoom9/front" name="front" show="true"/>
  
  <!--Turn triggers-->
  <ViewTrigger name="Down" next_view="View1_Back" type="fade_out"/>
  <ViewTrigger name="Right" next_view="View1_Right" type="fade_out"/>
  
  <!--Cursor triggers-->
  <CursorTrigger
    name="Trigger01"
    collision="rect"
    rect="430,90,710,720"
    cursor_style="use"
    trigger_type="event"
    trigger_event="View1_Front.onDoor"
    activate_own="true"/>
    
  <!--Events-->
  <Event name="View1_Front.onDown">
    <Action type="ActivateTrigger" name="Down"/>
  </Event>
  
  <Event name="View1_Front.onDoor">
    <Action type="ChangeArea" area="DreamRoom5" view="Zoom_Stairs" door_sound="true"/>
  </Event>
  
</Script>