<?xml version="1.0" encoding="utf-8"?>
<Script>
  <Setup name="Zoom_Chair" navigator="false" hud_state="back" text_fade="true"/>
  
  <!--Load content-->
  <AddImage path="World/DreamRoom9/handle_zoom2" name="zoom_chair" show="true"/>
  <AddImage path="World/DreamRoom9/handle_zoom1_x297y360" name="sledgehandle" show="true" dest_rect="297,360,593,360"/>
  
  <!--Turn triggers-->
  <ViewTrigger name="Back" next_view="View1_Back" type="fade_out"/>
  
  <!--Cursor triggers-->
  <CursorTrigger
    name="Trigger01"
    collision="rect"
    rect="297,360,890,720"
    cursor_style="use"
    trigger_type="event"
    trigger_event="Zoom_Chair.SledgeHandle"
    activate_own ="true"/>
    
  <!--Events-->
  <Event name="Zoom_Chair.onBack">
    <Action type="ActivateTrigger" name="Back"/>
  </Event>
  
  <Event name="Zoom_Chair.SledgeHandle">
    <Action type="AskPickup" item_id="DreamRoom9SledgeHandle"/>
  </Event>

  <Event name="Pickup.DreamRoom9SledgeHandle">
    <FadeOutImage name="sledgehandle"/>
    <RemoveTrigger name="Trigger01"/>
    <HandleEvent event="View1_Back.HandleSledgeHandle.1"/>
    <SetGlobalState state="DreamRoom9.SledgeHandle" value="1"/>
  </Event>
  
  <Event name="Zoom_Chair.HandleSledgeHandle.1">
    <HideImage name="sledgehandle"/>
    <RemoveTrigger name="Trigger01"/>
  </Event>
  
  <!--Handle states-->
  <HandleState state="DreamRoom9.SledgeHandle" event="Zoom_Chair.HandleSledgeHandle"/>
  
</Script>