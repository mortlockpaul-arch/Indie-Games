<?xml version="1.0" encoding="utf-8"?>
<Script>
  <Setup name="Stairs2_Front"/>
  <Navigator down="true"/>
  
  <!--Load content-->
  <AddImage path="World/DreamECT/stairs2" name="stairs2" show="true"/>
  
  <!--View triggers-->
  <ViewTrigger name="Down" next_view="Stairs2_Back" type="fade_out"/>

  <!--Cursor triggers-->
  <CursorTrigger
    name="Trigger01"
    collision="rect"
    rect="580,330,680,530"
    cursor_style="zoom"
    trigger_type="view"
    trigger_view="Bottom1_Front"
    viewtrigger_type="fade_out"/>
	
  <!--Events-->
  <Event name="Stairs2_Front.onDown">
    <Action type="ActivateTrigger" name="Down"/>
  </Event>
  
</Script>