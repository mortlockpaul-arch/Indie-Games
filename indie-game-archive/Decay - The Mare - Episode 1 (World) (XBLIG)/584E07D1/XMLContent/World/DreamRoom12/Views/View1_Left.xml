<?xml version="1.0" encoding="utf-8"?>
<Script>
  <Setup name="View1_Left"/>
  <Navigator down="true" left="true" right="true"/>
  
  <!--Load content-->
  <AddImage path="World/DreamRoom12/view4" name="view4" show="true"/>
  
  <!--Turn triggers-->
  <ViewTrigger name="Down" next_view="View1_Right" type="fade_out"/>
  <ViewTrigger name="Left" next_view="View1_Back" type="fade_out"/>
  <ViewTrigger name="Right" next_view="View1_Front" type="fade_out"/>
  <ViewTrigger name="Door" next_view="View1_Front" type="fade_to_black"/>
  
  <!--Cursor triggers-->
  <CursorTrigger
    name="Trigger01"
    collision="rect"
    rect="535,135,740,560"
    cursor_style="use"
    trigger_type="event"
    trigger_event="DreamRoom12.onLeftDoor"
    activate_own="true"/>
    
  <!--Events-->
  <Event name="View1_Left.onDown">
    <Action type="ActivateTrigger" name="Down"/>
  </Event>
  
  <Event name="View1_Left.onLeft">
    <Action type="ActivateTrigger" name="Left"/>
  </Event>
  
  <Event name="View1_Left.onRight">
    <Action type="ActivateTrigger" name="Right"/>
  </Event>
  
  <Event name="View1_Left.onReset">
    <Action type="GameDataArea" value="DreamRoom11"/>
    <Action type="GameDataView" value="Front_Door_Zoom"/>
  </Event>
  
  <Event name="View1_Left.onDoor">
    <Action type="ActivateTrigger" name="Door"/>
    <PlayDoorSound/>
  </Event>
  
</Script>