<?xml version="1.0" encoding="utf-8"?>
<Script>
  <Setup name="View1_Right"/>
  <Navigator left="true" right="true" down="true"/>
  
  <!--Load content-->
  <LoadContent type="TextureAnimation"
               path="World/DreamMainRoom/Animations/View1_Right/" images="1"
               combinedFrames="true" width="640" height="360" frames="3" random_mode="true"
               frameSmoothing="false" size="1280" fps="10"
               />

  <Action type="CreateAnimationInstance" path="World/DreamMainRoom/Animations/View1_Right/" name="tv_anim" dest_rect="0,0,1280,720"/>
  <Action type="AnimationInstance" name="tv_anim" action="show"/>
  <Action type="AnimationInstance" name="tv_anim" action="play"/>
  
  <!--View triggers-->
  <ViewTrigger name="Left" next_view="View1_Back" type="fade_to_black"/>
  <ViewTrigger name="Right" next_view="View1" type="fade_to_black"/>
  <ViewTrigger name="Down" next_view="View1_Left" type="fade_to_black"/>
  
  <!--Events-->
  <Event name="View1_Right.onLeft">
    <Action type="ActivateTrigger" name="Left"/>
  </Event>
  
  <Event name="View1_Right.onRight">
    <Action type="ActivateTrigger" name="Right"/>
  </Event>
  
  <Event name="View1_Right.onDown">
    <Action type="ActivateTrigger" name="Down"/>
  </Event>
  
  <Event name="View1_Right.onReset">
    <Case>
      <Check type1="GlobalState" value1="DreamRoom4.PuzzleCompleted" rule="==" type2="String" value2="1"/>
      <True>
        <Action type="GameDataArea" value="DreamECT"/>
        <Action type="GameDataView" value="View1_Back"/>
      </True>
      <False/>
    </Case>
  </Event>
  
</Script>