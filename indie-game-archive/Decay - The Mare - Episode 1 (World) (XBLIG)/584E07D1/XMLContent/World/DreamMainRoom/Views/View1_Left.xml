<?xml version="1.0" encoding="utf-8"?>
<Script>
  <Setup name="View1_Left"/>
  <Navigator left="true" right="true" down="true"/>
  
  <!--Load content-->
  <LoadContent type="TextureAnimation"
               path="World/DreamMainRoom/Animations/View1_Left/" images="1"
               combinedFrames="true" width="640" height="360" frames="3" random_mode="true"
               frameSmoothing="false" size="1280" fps="10"
               />

  <Action type="CreateAnimationInstance" path="World/DreamMainRoom/Animations/View1_Left/" name="tv_anim" dest_rect="0,0,1280,720"/>
  <Action type="AnimationInstance" name="tv_anim" action="show"/>
  <Action type="AnimationInstance" name="tv_anim" action="play"/>
  
  <!--View triggers-->
  <ViewTrigger name="Left" next_view="View1" type="fade_to_black"/>
  <ViewTrigger name="Right" next_view="View1_Back" type="fade_to_black"/>
  <ViewTrigger name="Down" next_view="View1_Right" type="fade_to_black"/>
  <ViewTrigger name="Zoom_Door" next_view="Zoom_Door2" type="fade_to_black"/>
  
  <!--Cursor triggers-->
  <CursorTrigger
    name="Trigger01"
    collision="rect"
    rect="370,110,780,580"
    cursor_style="zoom"
    trigger_type="view"
    trigger_view="View2"
    viewtrigger_type="fade_to_black"/>
	
  <CursorTrigger
    name="Trigger02"
    collision="rect"
    rect="890,400,930,450"
    cursor_style="use_small"
    trigger_type="event"
    trigger_event="DreamMainRoom.onLockedDoor"
    activate_own="true"/>
    
  <CursorTrigger
    name="Trigger03"
    collision="rect"
    rect="930,200,995,270"
    cursor_style="zoom_small"
    trigger_type="event"
    trigger_event="View1_Left.Zoom_Door"
    activate_own="true"/>
    
  <!--Events-->
  <Event name="View1_Left.onLeft">
    <Action type="ActivateTrigger" name="Left"/>
  </Event>
  
  <Event name="View1_Left.onRight">
    <Action type="ActivateTrigger" name="Right"/>
  </Event>
  
  <Event name="View1_Left.onDown">
    <Action type="ActivateTrigger" name="Down"/>
  </Event>
  
  <Event name="View1_Left.onReset">
    <Case>
      <Check type1="GlobalState" value1="DreamRoom4.PuzzleCompleted" rule="==" type2="String" value2="1"/>
      <True>
        <Action type="GameDataArea" value="DreamECT"/>
        <Action type="GameDataView" value="View1_Back"/>
      </True>
      <False/>
    </Case>
  </Event>
  
  <Event name="View1_Left.Zoom_Door">
    <HandleEvent event="Zoom_Door2.SetBack1"/>
    <Action type="ActivateTrigger" name="Zoom_Door"/>
  </Event>
  
</Script>